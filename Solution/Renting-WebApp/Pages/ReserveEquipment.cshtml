@page "{id:int}"
@model Renting_Website.Pages.ReserveEquipmentModel
@{
    ViewData["Title"] = "Reserve Equipment";
}

<h2>Reserve Equipment for @Model.Equipment.Name</h2>

<form method="post">
    <div class="form-group">
        <label for="StartDate">Start Date:</label>
        <input type="date" asp-for="StartDate" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="EndDate">End Date:</label>
        <input type="date" asp-for="EndDate" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Reserve</button>
    <a asp-page="/Content" class="btn btn-secondary">Cancel</a>
</form>
