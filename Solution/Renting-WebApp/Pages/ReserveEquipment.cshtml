@page "{id:int}"
@using Newtonsoft.Json
@model Renting_Website.Pages.ReserveEquipmentModel
@{
    ViewData["Title"] = "Reserve Equipment";
}

<h2 class="text-center">Reserve Equipment: @Model.Equipment?.Name</h2>

<div class="container mt-4">
    @if (Model.Equipment == null)
    {
        <p class="text-danger">Equipment not found. Please try again later.</p>
    }
    else
    {
        <form method="post" asp-page-handler="AddToBasket">
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="ReservationDate">Reservation Date:</label>
                <input asp-for="ReservationDate" id="reservationDate" type="date" class="form-control" />
                <span asp-validation-for="ReservationDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Add to Basket</button>
                <a asp-page="/Content" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const unavailableDates = @Html.Raw(JsonConvert.SerializeObject(Model.UnavailableDates));

        document.getElementById("reservationDate").addEventListener("input", function () {
            const selectedDate = new Date(this.value).toISOString().split('T')[0];

            if (unavailableDates.includes(selectedDate)) {
                alert("This date is already reserved. Please choose another date.");
                this.value = "";
            }
        });
    </script>
}
