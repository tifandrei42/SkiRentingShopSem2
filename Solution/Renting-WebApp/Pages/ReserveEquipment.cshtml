@page
@using Newtonsoft.Json
@model Renting_Website.Pages.ReserveEquipmentModel
@{
    ViewData["Title"] = "Reserve Equipment";
}

<h2 class="text-center">Reserve Equipment: @Model.Equipment?.Name</h2>

<div class="container mt-4">

    <div asp-validation-summary="All" class="text-danger"></div>

    @if (Model.Equipment == null)
    {
        <p class="text-danger">Equipment not found. Please try again later.</p>
    }
    else
    {
        <form method="post" asp-page-handler="AddToBasket">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Quantity" />

            <div class="form-group">
                <label asp-for="ReservationDate">Reservation Date:</label>
                <input asp-for="ReservationDate" id="reservationDate" class="form-control" type="text"/>
                <span asp-validation-for="ReservationDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Add to Basket</button>
                <a asp-page="/Content" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const unavailableDates = @Html.Raw(JsonConvert.SerializeObject(Model.UnavailableDates.Select(d => d.ToString("yyyy-MM-dd"))));

        flatpickr("#reservationDate", {
            dateFormat: "Y-m-d",      
            disable: unavailableDates, // Disable unavailable dates
            minDate: "today",         // Disable past dates
            defaultDate: '@Model.ReservationDate.ToString("yyyy-MM-dd")' // Set default date
        });
    </script>
}
