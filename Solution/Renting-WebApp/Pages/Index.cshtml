@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="section-1 font-monospace">
    <h1 class="faded-title">Welcome to Sweet Renting</h1>
    <div class="container-grid">
        <div class="content-box left-box">
            <p class="lead">Experience the Thrill of Skiing with the Best Gear Available!</p>
            <p>
                Welcome to our online ski rental service, where you can easily find and reserve the perfect ski equipment to
                make your day at the resort unforgettable. Our website allows you to browse a wide selection of ski gear, compare ratings,
                and select the equipment that suits your needs best.
            </p>
        </div>
        <div class="content-box right-box">
            <p>
                Whether you're a seasoned skier or a beginner, our easy-to-use platform helps you reserve the gear you need,
                all from the comfort of your home. You can also log in to view your reservation history, manage your account,
                and even leave reviews of the equipment you rented.
            </p>
        </div>
        <div class="content-box left-box lower-box">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    🎿 <strong>A Wide Range of Ski Equipment:</strong> Discover various types of skis,
                    snowboards, boots, and more.
                </li>
                <li class="list-group-item">
                    📅 <strong>Easy Online Reservations:</strong> Reserve the equipment you need.
                </li>
                <li class="list-group-item">
                    🛠️ <strong>Employee and Stock Management:</strong> Manage inventory and reservations.
                </li>
            </ul>
        </div>
    </div>
</section>
<section class="section-2">
    <h2>SKI2RENT Advantages</h2>
</section>
<section class="section-3">
    <h2>Our Services</h2>
</section>

