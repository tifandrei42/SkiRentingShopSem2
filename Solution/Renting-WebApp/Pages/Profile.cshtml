@page "{id:int}"
@model Renting_Website.Pages.CustomerProfileModel
@{
    ViewData["Title"] = "Customer Profile";
}

@using System.Security.Claims
<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg p-4 mb-5 bg-white rounded" style="width: 400px;">
        <div class="card-body text-center">
            <div class="mb-3">
                <img src="/path-to-snowboard-icon.png" alt="Snowboard Icon" class="img-fluid rounded-circle" style="width: 100px; height: 100px;">
            </div>

            <h3 class="card-title text-primary mb-4">Your Profile</h3>

            <ul class="list-group list-group-flush text-start">
                <li class="list-group-item"><strong>First Name:</strong> @Model.Customer.FirstName</li>
                <li class="list-group-item"><strong>Last Name:</strong> @Model.Customer.LastName</li>
                <li class="list-group-item"><strong>Username:</strong> @Model.Customer.UserName</li>
                <li class="list-group-item"><strong>Email:</strong> @Model.Customer.Email</li>
                <li class="list-group-item"><strong>Date of Birth:</strong> @Model.Customer.DateOfBirth.ToShortDateString()</li>
                <li class="list-group-item"><strong>Phone Number:</strong> @Model.Customer.PhoneNumber</li>
                <li class="list-group-item"><strong>Address:</strong> @Model.Customer.Address</li>
            </ul>

            <div class="mt-4">
                <a asp-page="/Edit" asp-route-id="@Model.Customer.User_Id" class="btn btn-primary">Edit Profile</a>
                <a asp-page="/DeleteAccount" asp-route-id="@Model.Customer.User_Id" class="btn btn-danger">Delete Account</a>
            </div>
        </div>
    </div>
</div>