@page
@model Renting_Website.Pages.ContentModel
@{
    ViewData["Title"] = "Equipment Content";
}

<h2>Available Equipment</h2>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Brand</th>
                <th>Size</th>
                <th>Price Per Day</th>
                <th>Type</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipment in Model.EquipmentList)
            {
                <tr>
                    <td>@equipment.Name</td>
                    <td>@equipment.Brand</td>
                    <td>@equipment.Size</td>
                    <td>@equipment.PricePerDay.ToString("C")</td>
                    <td>@equipment.EquipmentType</td>
                    <td>
                        @if (!string.IsNullOrEmpty(equipment.ImagePath))
                        {
                            <img src="@equipment.ImagePath" alt="@equipment.Name" width="50" />
                        }
                    </td>
                    <td>
                        <a asp-page="/ReserveEquipment" asp-route-id="@equipment.EquipmentId" class="btn btn-primary">Reserve</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>