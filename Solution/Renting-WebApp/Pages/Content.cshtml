@page
@model Renting_Website.Pages.ContentModel
@{
    ViewData["Title"] = "Equipment Content";
}

<h2 class="align-content-center">Available Equipment</h2>

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label for="brandFilter">Brand</label>
            <input type="text" id="brandFilter" name="BrandFilter" value="@Model.BrandFilter" class="form-control" placeholder="Enter brand name" />
        </div>
        <div class="col-md-4">
            <label for="minPrice">Min Price</label>
            <input type="number" id="minPrice" name="MinPrice" value="@Model.MinPrice" class="form-control" placeholder="Enter minimum price" />
        </div>
        <div class="col-md-4">
            <label for="maxPrice">Max Price</label>
            <input type="number" id="maxPrice" name="MaxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Enter maximum price" />
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
        <div class="col-md-6 text-right">
            <a asp-page="/Content" class="btn btn-secondary">Clear Filters</a>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var equipment in Model.EquipmentList)
    {
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                @if (!string.IsNullOrEmpty(equipment.ImagePath))
                {
                    <img class="card-img-top" src="@Url.Content($"~/{equipment.ImagePath}")" alt="@equipment.Name" />
                }
                else
                {
                    <img class="card-img-top" src="@Url.Content("~/images/placeholder.jpg")" alt="No image available" />
                }
                <div class="card-body text-center">
                    <h5 class="card-title">@equipment.Name</h5>
                    <p class="card-text">@equipment.PricePerDay.ToString("C")</p>
                    <a asp-page="/DetailedProductView" asp-route-id="@equipment.EquipmentId" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
