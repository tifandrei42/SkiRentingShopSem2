@page
@model Renting_Website.Pages.RegisterModel
@{
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card p-5 bg-light" style="width: 400px;">
        <div class="card-body">
            <h5 class="card-title text-center mb-4">@Model.PageTitle</h5>

            <form method="post">

                <div class="form-group mb-3">
                    <label asp-for="User.FirstName">First Name:*</label>
                    <span asp-validation-for="User.FirstName" class="text-danger"></span>
                    <input asp-for="User.FirstName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.LastName">Last Name:*</label>
                    <span asp-validation-for="User.LastName" class="text-danger"></span>
                    <input asp-for="User.LastName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.UserName">Username:*</label>
                    <span asp-validation-for="User.UserName" class="text-danger"></span>
                    <input asp-for="User.UserName" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.Email">Email:*</label>
                    <span asp-validation-for="User.Email" class="text-danger"></span>
                    <input asp-for="User.Email" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.DateOfBirth">Date of birth:*</label>
                    <span asp-validation-for="User.DateOfBirth" class="text-danger"></span>
                    <input asp-for="User.DateOfBirth" class="form-control" type="date" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.PhoneNumber">Phone Number:*</label>
                    <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                    <input asp-for="User.PhoneNumber" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.Address">Address:*</label>
                    <span asp-validation-for="User.Address" class="text-danger"></span>
                    <input asp-for="User.Address" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="User.Password">Password:*</label>
                    <span asp-validation-for="User.Password" class="text-danger"></span>
                    <input asp-for="User.Password" class="form-control" type="password" />
                </div>

                <div class="form-group text-center">
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Enable client-side validation -->
    <partial name="_ValidationScriptsPartial" />
}