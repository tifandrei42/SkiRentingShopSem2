@page
@model Renting_Website.Pages.BasketModel
@{
    ViewData["Title"] = "Basket";
}
<div class="container mt-5">
    <h2 class="mb-4 text-center">Basket</h2>

    @if (Model.Basket.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Equipment</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Price/Day</th>
                        <th>Total Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Basket)
                    {
                        <tr>
                            <td>@item.Equipment.Name</td>
                            <td>@item.Equipment.Category.ToString()</td>
                            <td>@item.ReservationDate.ToShortDateString()</td>
                            <td>@item.Equipment.PricePerDay.ToString("C")</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                            <td>
                                <form method="post" asp-page-handler="Remove" asp-route-id="@item.Equipment.EquipmentId">
                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form method="post" asp-page-handler="Clear" class="text-center mt-4">
            <button type="submit" class="btn btn-warning">Clear Basket</button>
        </form>
    }
    else
    {
        <p class="text-center">Your basket is empty.</p>
    }
</div>